<?xml version="1.0"?>
<robot name="rubot_mecanum">
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
    <material name="pink">
        <color rgba="1.0 0.4 0.7 1.0"/>
    </material>
    <material name="fuchsia">
        <color rgba="0.9 0.0 0.5 1.0"/>
    </material>
    <material name="lilac">
        <color rgba="0.78 0.70 0.95 1.0"/>
    </material>

  <!-- ===== Frames base ===== -->
  <link name="base_footprint"/>

  <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Visual (per RViz) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/rubot/base_link.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>

    <!-- Collision (per costmaps si vols usar robot footprint/voxel amb robot model) -->
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.25 0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- ===== Rodes (només visuals, fixed) ===== -->
  <joint name="upper_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_left_wheel"/>
    <origin xyz="0.07 0.10 0.00" rpy="0 0 0"/>
  </joint>
  <link name="upper_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/rubot/upper_left_wheel.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pink"/>
    </visual>
  </link>

  <joint name="lower_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lower_left_wheel"/>
    <origin xyz="-0.085 0.10 0.00" rpy="0 0 0"/>
  </joint>
  <link name="lower_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/rubot/lower_left_wheel.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pink"/>
    </visual>
  </link>

  <joint name="upper_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_right_wheel"/>
    <origin xyz="0.07 -0.10 0.00" rpy="0 0 3.14159"/>
  </joint>
  <link name="upper_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/rubot/upper_right_wheel.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pink"/>
    </visual>
  </link>

  <joint name="lower_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lower_right_wheel"/>
    <origin xyz="-0.085 -0.10 0.00" rpy="0 0 3.14159"/>
  </joint>
  <link name="lower_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/rubot/lower_right_wheel.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pink"/>
    </visual>
  </link>

  <!-- ===== Lidar frame ===== -->
  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>
  <link name="base_scan">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/rubot/Lidar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="lilac"/>
    </visual>
  </link>

  <!-- ===== Top 3D Part (Number 2) ===== -->
  <joint name="top_part_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_part"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>

  <link name="top_part">
    <!-- VISUAL (Number 2 mesh) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/rubot/number2.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="fuchsia"/>
    </visual>

    <!-- COLLISION (simple box for stability in Gazebo) -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.06"/>
      </geometry>
    </collision>

    <!-- INERTIAL (required for Gazebo physics) -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <!-- Gazebo material -->
  <gazebo reference="top_part">
    <material>Gazebo/Purple</material>
  </gazebo>

</robot>