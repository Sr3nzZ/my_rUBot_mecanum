<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sign_left_gz">
    <static>true</static>

    <!-- Stand (mesh visual, box collision) -->
    <link name="stand">
      <!-- Visual uses the original mesh -->
      <visual name="stand_visual">
        <geometry>
          <mesh>
            <uri>model://sign_left_gz/meshes/sign_stand.obj</uri>
            <scale>0.1 0.1 0.1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Box collision sized from mesh bounding box (scaled) -->
      <collision name="stand_collision">
        <pose>0.001343 0.067500 0.000997 0 0 0</pose>
        <geometry>
          <box>
            <size>0.093711 0.135000 0.066794</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Board (mesh visual with texture, box collision) -->
    <link name="board">
      <!-- Keep the original relative placement used in the Classic model -->
      <pose>-0.02 0 0.19 -1.57 0 0</pose>

      <visual name="board_visual">
        <geometry>
          <mesh>
            <uri>model://sign_left_gz/meshes/sign_board.obj</uri>
            <scale>0.1 0.1 0.1</scale>
          </mesh>
        </geometry>

        <!-- PBR material (Gazebo Sim) -->
        <material>
          <pbr>
            <metal>
              <albedo_map>model://sign_left_gz/materials/textures/left.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.9</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="board_collision">
        <geometry>
          <box>
            <size>0.134000 0.114375 0.016019</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="stand_to_board" type="fixed">
      <parent>stand</parent>
      <child>board</child>
    </joint>

  </model>
</sdf>
