<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rubot_mecanum">
    <static>false</static>

    <!-- Inclou el teu model URDF ja convertit a SDF/SDFormat -->
    <!-- Opció simple: incloure un model ja exportat, o usar spawn amb robot_description (veuràs a launch). -->

    <!-- Link “camera” amb sensor RGBD natiu de gz-sim -->
    <link name="camera">
      <pose>0.13 0 0.05 0 0 0</pose>

      <sensor name="rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>

        <rgbd_camera>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </camera>

          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </rgbd_camera>
      </sensor>
    </link>
  </model>
</sdf>
