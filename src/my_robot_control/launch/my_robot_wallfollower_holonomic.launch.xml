<launch>
        <!-- ========================
         Launch Arguments
         ======================== -->
    <arg name="distance_limit"  default="0.25" />
    <arg name='distance_front_limit' default="0.3" />
    <arg name="tolerance"       default="0.05" />
    <arg name="forward_speed"   default="0.2" />
    <arg name="turn_speed"      default="0.3" />
    <arg name="time_to_stop"    default="20.0" />

        <!-- ========================
         Nodes
         ======================== -->

    <node
        pkg="my_robot_control"
        exec="my_robot_wallfollower_holonomic_exec"
        name="wall_follower_holonomic"
        output="screen">

        <param name="time_to_stop" value="$(var time_to_stop)"/>

    </node>

</launch>